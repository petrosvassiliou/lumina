<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Deep OLED Pitch-Black Base Window Theme (#050507) for Zero-Flash Cinema Startup -->
    <style name="Theme.Lumina" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/lumina_oled_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:colorMode" tools:targetApi="26">hdr</item>
    </style>

    <style name="Theme.Lumina.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lumina_oled_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Lumina</item>
    </style>

    <color name="lumina_oled_black">#050507</color>
</resources>
