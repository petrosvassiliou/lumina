<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Strict allowlist mode: only Room DB and DataStore preferences are included;
         AndroidKeyStore-bound sharedpref/lumina_lan_vault.xml is excluded automatically. -->
    <cloud-backup>
        <include domain="database" path="lumina_media.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lumina_media.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
